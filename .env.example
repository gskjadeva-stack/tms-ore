# Env var names only — NEVER commit values.
# Root .env.example is canonical. server/.env.example mirrors the
# server-scoped subset. Set real values in Render dashboard
# (backend service > Environment) and Vercel dashboard (frontend).
# Rotate any secret that was ever pasted in chat.

# --- Supabase Postgres (Prisma runtime, pooler 6543 + pgbouncer) ---
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Supabase Postgres (migrations only, session 5432) ---
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Custom HMAC token secret (random 32-byte hex; replaces server/.token-secret file) ---
TOKEN_SECRET=""

# --- Supabase project (PLACEHOLDER Auth JWT + Storage activation only; unused until activated) ---
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY=""

# --- Supabase service_role (OPTIONAL, server-only, NEVER browser; unused by placeholders) ---
SUPABASE_SERVICE_ROLE_KEY=""

# --- Port (Render assigns; default 3010 local) ---
PORT="3010"

# --- Env name (production on Render; gates dev_otp/dev_reset_token out of JSON) ---
NODE_ENV="production"

# --- Frontend API base (OPTIONAL; only if frontend/backend origins split; default same-origin relative /api) ---
VITE_API_URL=""

# --- LEGACY UNUSED (local MSSQL backend retired; server/schema.sql is a frozen reference) ---
# MSSQL_SERVER=""
# MSSQL_DATABASE=""
# MSSQL_USER=""
# MSSQL_PASSWORD=""
